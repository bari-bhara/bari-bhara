# Copy to .env.local and fill in. Never commit real values.
#
# Local development: `pnpm db:start` prints the local URL and publishable key.
# Put them in .env.development.local (loaded ahead of .env.local by `next dev`).

# --- Public (sent to the browser) -------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Base URL used in auth email links, e.g. https://baribhara.example.com
NEXT_PUBLIC_SITE_URL=

# --- Server only (never prefix with NEXT_PUBLIC_) ------------------------------
# Payment reminder emails (Phase 8)
RESEND_API_KEY=
EMAIL_FROM=
